    {
      "id": "SSH-004",
      "title": "最大认证尝试次数不超过 4",
      "category": "SSH 认证",
      "severity": "high",
      "kind": "sshd",
      "description": "最大认证尝试次数不超过 4",
      "remediation": "设置 MaxAuthTries 4（或更小），降低口令爆破成功的概率。",
      "reference": "CIS 5.2.5",
      "check": {
        "type": "sshdNumeric",
        "key": "MaxAuthTries",
        "op": "<=",
        "value": 4,
        "absentMeans": "fail"
      },
      "fix": {
        "args": [
          "4"
        ]
      },
      "samples": {
        "pass": [],
        "fail": [
          {
            "file": "/etc/ssh/sshd_config",
            "find": "MaxAuthTries 3",
            "replace": "MaxAuthTries 8"
          }
        ],
        "passNote": "基础样例已满足该规则",
        "failNote": "应用补丁后该规则应判定为不通过"
      }
    },
