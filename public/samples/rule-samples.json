[
  {
    "id": "SSH-001",
    "title": "禁止 root 直接登录",
    "kind": "sshd",
    "severity": "critical",
    "category": "SSH 访问控制",
    "reference": "CIS 5.2.8 · 等保 8.1.4.1",
    "check": {
      "type": "sshdValue",
      "key": "PermitRootLogin",
      "in": [
        "no"
      ],
      "absentMeans": "fail"
    },
    "passSample": [],
    "failSample": [
      {
        "file": "/etc/ssh/sshd_config",
        "find": "PermitRootLogin no",
        "replace": "PermitRootLogin yes"
      }
    ]
  },
