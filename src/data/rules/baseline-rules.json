{
  "version": 1,
  "name": "主机安全配置基线（SSH / Nginx / 内核参数）",
  "description": "覆盖 SSH 守护进程、Nginx 反向代理与 Linux 内核参数的合规检查。每条规则均附带一组可复现的通过/不通过样例，样例以补丁形式作用于内置基础配置。",
  "rules": [
    {
      "id": "SSH-001",
      "title": "禁止 root 直接登录",
      "category": "SSH 访问控制",
      "severity": "critical",
      "kind": "sshd",
      "description": "root 拥有无限权限，直接登录一旦凭证泄露影响面最大。",
      "remediation": "将 /etc/ssh/sshd_config 中的 PermitRootLogin 设置为 no，改用普通账号登录后 sudo 提权。",
      "reference": "CIS 5.2.8 · 等保 8.1.4.1",
      "check": {
        "type": "sshdValue",
        "key": "PermitRootLogin",
        "in": [
          "no"
        ],
        "absentMeans": "fail"
      },
      "fix": {
        "args": [
          "no"
        ]
      },
      "samples": {
        "pass": [],
        "fail": [
          {
            "file": "/etc/ssh/sshd_config",
            "find": "PermitRootLogin no",
            "replace": "PermitRootLogin yes"
          }
        ],
        "passNote": "基础样例已满足该规则",
        "failNote": "应用补丁后该规则应判定为不通过"
      }
    },
    {
      "id": "SSH-002",
      "title": "禁用密码认证，仅允许公钥",
