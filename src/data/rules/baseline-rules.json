      "reference": "CIS 5.2.16",
      "check": {
        "type": "sshdNumeric",
        "key": "ClientAliveInterval",
        "op": ">",
        "value": 0,
        "absentMeans": "fail"
      },
      "fix": {
        "args": [
          "300"
        ]
      },
      "samples": {
        "pass": [],
