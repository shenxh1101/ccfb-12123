    {
      "id": "SSH-013",
      "title": "禁用非安全加密算法",
      "category": "SSH 加密",
      "severity": "high",
      "kind": "sshd",
      "description": "禁用非安全加密算法",
      "remediation": "在 Ciphers 中移除 CBC/3DES/RC4/Blowfish 等弱算法，仅保留 chacha20-poly1305 与 AES-GCM。",
      "reference": "CIS 5.2.12",
      "check": {
        "type": "sshdListExcludes",
        "key": "Ciphers",
        "forbidden": [
          "3des-cbc",
          "aes128-cbc",
          "aes192-cbc",
          "aes256-cbc",
          "arcfour",
          "arcfour128",
          "arcfour256",
          "blowfish-cbc",
          "cast128-cbc"
        ]
      },
      "samples": {
        "pass": [],
        "fail": [
          {
            "file": "/etc/ssh/sshd_config",
            "find": "Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com",
            "replace": "Ciphers 3des-cbc,aes128-cbc,aes256-gcm@openssh.com"
          }
        ],
        "passNote": "基础样例已满足该规则",
        "failNote": "应用补丁后该规则应判定为不通过"
      }
    },
    {
      "id": "SSH-014",
      "title": "禁用弱 MAC 算法",
      "category": "SSH 加密",
      "severity": "high",
      "kind": "sshd",
      "description": "禁用弱 MAC 算法",
      "remediation": "在 MACs 中移除 MD5/SHA1/RIPEMD160，保留 ETM 模式的 SHA2 算法。",
      "reference": "CIS 5.2.13",
      "check": {
        "type": "sshdListExcludes",
        "key": "MACs",
        "forbidden": [
          "hmac-md5",
          "hmac-md5-96",
          "hmac-sha1",
          "hmac-sha1-96",
          "hmac-ripemd160",
          "umac-64@openssh.com"
        ]
      },
      "samples": {
        "pass": [],
        "fail": [
          {
            "file": "/etc/ssh/sshd_config",
            "find": "MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com",
            "replace": "MACs hmac-md5,hmac-sha1,hmac-sha2-256-etm@openssh.com"
          }
        ],
        "passNote": "基础样例已满足该规则",
        "failNote": "应用补丁后该规则应判定为不通过"
      }
    },
    {
      "id": "SSH-015",
      "title": "禁用基于 SHA1 的密钥交换",
      "category": "SSH 加密",
      "severity": "high",
      "kind": "sshd",
      "description": "禁用基于 SHA1 的密钥交换",
      "remediation": "在 KexAlgorithms 中移除 SHA1 系列，保留 curve25519-sha256 与 group16-sha512。",
      "reference": "CIS 5.2.14",
      "check": {
        "type": "sshdListExcludes",
        "key": "KexAlgorithms",
        "forbidden": [
          "diffie-hellman-group1-sha1",
          "diffie-hellman-group14-sha1",
          "diffie-hellman-group-exchange-sha1",
          "gss-group1-sha1"
        ]
      },
      "samples": {
        "pass": [],
        "fail": [
          {
            "file": "/etc/ssh/sshd_config",
            "find": "KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512",
            "replace": "KexAlgorithms diffie-hellman-group1-sha1,diffie-hellman-group14-sha1,curve25519-sha256"
          }
        ],
        "passNote": "基础样例已满足该规则",
        "failNote": "应用补丁后该规则应判定为不通过"
      }
    },
    {
      "id": "SSH-016",
      "title": "配置登录警告 Banner",
      "category": "SSH 访问控制",
      "severity": "low",
      "kind": "sshd",
      "description": "配置登录警告 Banner",
      "remediation": "设置 Banner /etc/ssh/issue.net，在认证前展示经授权的访问声明；Banner none 等于关闭提示。",
      "reference": "CIS 5.2.19 · 等保 8.1.4.1",
      "check": {
        "type": "sshdValue",
        "key": "Banner",
        "matches": "^(?!(none|NONE)$).+"
      },
      "fix": {
        "args": [
          "/etc/ssh/issue.net"
        ]
      },
      "samples": {
        "pass": [],
        "fail": [
          {
            "file": "/etc/ssh/sshd_config",
            "find": "Banner /etc/ssh/issue.net",
            "replace": "Banner none"
          }
        ],
        "passNote": "基础样例已满足该规则",
        "failNote": "应用补丁后该规则应判定为不通过"
      }
